# DecisionOS configuration. Never commit .env.
COS_ENV=development
COS_BASE_URL=http://127.0.0.1:5087
PORT=5087
# Generate once and keep stable (see deploy/README.md).
FLASK_SECRET_KEY=
COS_ENCRYPTION_KEY=

# Google Cloud project: Firestore (data) + Vertex AI Gemini (agent).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash
FIRESTORE_DATABASE=(default)
# Local only: DECISIONOS_STORE=memory runs without Firestore (data is lost on restart).
# DECISIONOS_STORE=memory
# Alternative to Vertex AI for local development: a Gemini API key from AI Studio.
# GEMINI_API_KEY=

# Firebase Authentication (Google sign-in). Web API key is public by design.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Run the leased background worker inside the web process (Cloud Run).
COS_WORKER_INLINE=1

# Optional email/password signup (verification mail). Without SMTP, sign-in is Firebase-only in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Operator OAuth apps for live connectors; customers authorize their own accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Dodo Payments billing and Cloudflare Turnstile.
DODO_ENV=test
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRO_PRODUCT_ID=
DODO_TEAM_PRODUCT_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
